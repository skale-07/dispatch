# Docker build context hygiene (deploy/Dockerfile). The Dockerfile only
# COPYs specific paths, but the context itself must never carry secrets or
# bulk data to the daemon.
.git
.githooks
.history
.claude
.vscode
.idea
node_modules
frontend/node_modules
frontend/dist
dist
data
private
artifacts
cache
traces
screenshots
browser-profiles
agent
tests
docs
*.log
.env
.env.*
!.env.example
*.storage.json
*.enc
