# Copy to .env — that file is the switchboard. `npm run` loads it (and it
# wins over leftover PowerShell $env: values). Do NOT put CANDIDATE_DATA_KEY
# plaintext here next to sensitive-profile.enc — use OS secret store / DPAPI
# (Phase 2).

NODE_ENV=development
DATABASE_PATH=data/app.sqlite

# Fallback resume auto-attached when an application reaches the materials
# stage with none registered (needed for unattended L3 sessions). Plain path.
# Point this at your REAL resume file — an application that reaches the
# materials stage with none registered parks here otherwise (8 of 14 apps
# in one live session died on the placeholder). auto:cycle preflight now
# reports whether this file exists before the queue runs.
DEFAULT_RESUME_PATH=private/candidate/resumes/default.pdf
LOG_LEVEL=info

# Staged rollout (defaults fail-closed)
DRY_RUN=true
FORM_FILL_ENABLED=false
SUBMIT_ENABLED=false
# ats:fill --submit is sandbox/loopback only and still requires this flag
# plus the confirmation prompt (or --yes when the next flag is false).
SUBMIT_REQUIRES_LOCAL_CONFIRMATION=true
MAX_UNATTENDED_SUBMISSIONS_PER_RUN=0
OUTLOOK_DRAFTS_ENABLED=false
# Create Gmail DRAFTS via your signed-in web session (never sends — the
# Send control is a forbidden selector; drafts save via Save & close).
GMAIL_DRAFTS_ENABLED=false
LINKEDIN_ENRICHMENT_ENABLED=false
JOBRIGHT_AUTOFILL_ENABLED=false
NATIVE_AUTOFILL_ENABLED=false
# D-rev: enqueue jobs straight from the ATSes' own public board APIs
# (Greenhouse/Lever/Ashby/Workable; unauthenticated read-only GETs).
# Creates jobs + applications in the local queue, so it is a capability.
ATS_DISCOVERY_ENABLED=false
# Company-hosted forms with no vendor adapter (tesla.com/careers,
# jobs.gusto.com, avature, ...) are handled by the generic adapter with NO
# separate flag (operator directive 2026-08-14 — the old GENERIC_ATS_ENABLED
# gate parked the entire long tail as UNSUPPORTED_ATS). Trust comes from
# provenance (JobRight posting -> navigation), and mutation still requires
# FORM_FILL_ENABLED / DRY_RUN=false / SUBMIT_ENABLED like every adapter.

# Dashboard (Phase 13)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788

# Operator console (frontend + guarded mutation API). Localhost only.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8899
# Hosted console (deploy/first-deploy.md Part C2; roadmap "Hosted-auth
# design"). OFF = the local model exactly: loopback bind, Host pin,
# per-boot token. ON = the console may bind 0.0.0.0; EVERY /api request
# must carry a Supabase Auth JWT (verified against SUPABASE_URL's JWKS,
# issuer + audience + expiry checked) whose user id is allowlisted; the
# Host header must be one of the deployed hostnames; all mutations are
# refused (read-only). Refuses to boot unless SUPABASE_URL and BOTH lists
# are set. Never enable on the engine machine's local console.
CONSOLE_HOSTED_MODE_ENABLED=false
# CONSOLE_HOSTED_ALLOWED_HOSTS=console.your-domain.example
# CONSOLE_HOSTED_ALLOWED_USER_IDS=auth-users-uuid-of-the-operator

# L3 kill switch: the console automation worker (unattended apply while
# armed) is refused unless this is true, regardless of any arm. Fail-closed.
# AUTOMATION_ENABLED=true

# Sensitive profile: on Windows, AES key is DPAPI-wrapped at
# private/candidate/master.key.dpapi (created automatically).
# Do NOT put CANDIDATE_DATA_KEY in this file for normal use.
# Tests/dev only:
# ALLOW_INSECURE_CANDIDATE_KEY=1
# CANDIDATE_DATA_KEY=replace-with-long-random-secret

# Prefer system Chrome for Google OAuth (JobRight Sign in with Google).
# Playwright's bundled Chromium is blocked by Google ("browser may not be secure").
BROWSER_CHANNEL=chrome

# Hard-stop pipeline on heuristic essay detection (ESSAY_REQUIRED). Default
# off — label heuristics false-positive on demographic combobox wording.
# Free-text still never auto-fills. Set true only for the human resume-essay
# flow; even then, only REQUIRED essay fields block (optional never do).
# ESSAY_REQUIRED_GATE_ENABLED=true

# Phase 5.6H: generating a resume mutates live JobRight. Fail-closed.
# Requires DRY_RUN=false as well; SUBMIT_ENABLED must stay false.
# MATERIALS_DOWNLOAD_ENABLED=true

# Phase 5: native Greenhouse fill requires both of these to mutate a form.
# Defaults stay fail-closed. SUBMIT_ENABLED must remain false until Phase 7.
# FORM_FILL_ENABLED=true
# DRY_RUN=false

# Default JobRight feed for recorder / validation
JOBRIGHT_FEED_URL=https://jobright.ai/jobs/recommend

# LLM provider keys. Default preference at every LLM boundary (outreach
# generation, screener mapping/prediction, essay drafts, healer proposals,
# and the nav agent sidecar): ANTHROPIC_API_KEY first, OPENAI_API_KEY
# second, MOONSHOT_API_KEY (Kimi) last. Set any subset. Each call is paid
# API spend — every surface stays fail-closed behind its own capability flag.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_LLM_MODEL=claude-opus-5
# OPTIONAL cost split. Applier surfaces (screener classify/map/predict,
# essay draft + autofill) are ~97% of token spend and every answer is
# re-validated deterministically, so a cheaper tier can hold there while
# outreach email prose stays on ANTHROPIC_LLM_MODEL. UNSET ⇒ the applier
# uses ANTHROPIC_LLM_MODEL — a cheaper model on answers that go into real
# applications is a quality tradeoff, so opt in deliberately.
# ANTHROPIC_APPLIER_MODEL=claude-sonnet-5
# OPENAI_API_KEY=sk-your-key-here
# EMAIL_LLM_MODEL=gpt-5-mini
# Kimi K3 via Moonshot AI's OpenAI-compatible API (api.moonshot.ai).
# MOONSHOT_API_KEY=sk-your-moonshot-key-here
# KIMI_LLM_MODEL=kimi-k3
# Force one provider instead of the key-presence order. A missing key for
# the forced provider is a hard refusal, never a silent fallback.
# LLM_PROVIDER=kimi
# Nav agent (browser-use sidecar) model override. Must name a model of the
# ACTIVE provider (defaults: claude-sonnet-4-6 with Anthropic, gpt-5-mini
# with OpenAI, kimi-k3 with Kimi).
# NAV_AGENT_MODEL=claude-sonnet-4-6
# The in-process application navigator uses this override too, or the
# active provider's configured model. It requests high reasoning effort
# with masked screenshots, observed controls, frames, and action history.
# Requires NAVIGATION_ENABLED + NAV_LLM_ASSIST_ENABLED + AGENT_FALLBACK_ENABLED
# and DRY_RUN=false. Budgets are settings, not capability flags.
# NAV_SUPERVISOR_MAX_STEPS=20
# NAV_SUPERVISOR_TIMEOUT_MS=180000

# JobRight browser-extension preflight (extension-first fill). Optional:
# pin the extension's Chrome Web Store id so jobright:ext-check matches by
# exact id instead of a title heuristic. Not a capability flag.
# JOBRIGHT_EXTENSION_ID=your-extension-id-here

# Outreach email generation — fail-closed by default.
# EMAIL_GENERATION_ENABLED=true

# Phase 6 J1 authoring sidecar (inert unless enabled; python venv required)
# AGENT_AUTHORING_ENABLED=true
# LLM assist that maps unknown screener-question labels to answer-bank keys
# (labels+options+key descriptions go to the model; ANSWERS never do, and the
# chosen answer must still match a page option deterministically).
# SCREENER_LLM_MATCH_ENABLED=true
# Screener answer PREDICTION: for questions no bank key covers, the LLM
# proposes an answer from about-me.md + your existing bank answers. The
# proposal only ever lands in a review item — you approve (one click) or
# edit, and the approved answer joins screeners.json as a custom entry so
# every future occurrence fills deterministically. Nothing predicted is
# ever filled without that one-time approval.
# SCREENER_PREDICT_LLM_ENABLED=true
# Stage-1 self-improvement loop: after an armed session ends, commit+push
# artifacts/ to the current branch so the analysis agent sees fresh run
# data without a manual push. Never bypasses the pre-commit secret gate.
# ARTIFACT_AUTOPUSH_ENABLED=true
# Essay DRAFT assistant: generates suggestion drafts for required essay
# questions from private/candidate/about-me.md + the job posting. Drafts
# land INSIDE the essay review item — the human edits/approves before any
# fill; essays are never auto-filled.
# ESSAY_DRAFT_ENABLED=true

# Generate essay answers from private/candidate/about-me.md and FILL them.
# Also unlocked when SCREENER_PREDICT_LLM_ENABLED is on. Requires
# about-me.md and an LLM key; generated text must pass the same validation
# a review draft does, and each answer is recorded on its plan entry.
# Both flags off / no context / rejected draft => parks with the real reason.
# ESSAY_AUTOFILL_ENABLED=true
# AGENT_CDP_URL=http://127.0.0.1:9222
# #233: run the Gmail tail (drafts + verification-code reads) in its OWN
# debug Chrome so it never competes with the applier for the browser the
# live fill is typing into. Start it with `npm run chrome:debug:gmail`
# (clones the jobright debug profile once, so the Google session carries
# over), then point this at it. Unset or unreachable => the Gmail tail
# uses AGENT_CDP_URL exactly as before; a second browser is an
# optimisation, never a precondition for drafting.
# OUTREACH_CDP_URL=http://127.0.0.1:9223
# Which sidecar drives agent navigation turns (S-spike): browser_use
# (default, Python) or stagehand (Node; `cd agent/stagehand && npm install`
# once). Same contract, same CDP seam, same validation either way — see
# docs/agent-engine-decision.md for the pre-registered promotion bar.
# AGENT_ENGINE=browser_use

# Phase 6a': sidecar escalation in the fill healer. The deterministic
# in-process heal pass always runs; this flag only unlocks the sidecar layer.
# AGENT_FALLBACK_ENABLED=true

# LLM failure triage (night25): after a run fails, the model chooses ONE
# remediation from an enumerated action set (requeue / reopen navigation /
# park / abandon / engage agent leg). Every choice is re-validated
# deterministically (set membership, forbidden-history, state-machine
# preconditions) and executed only through existing legal primitives with
# hard caps; the read-back sweep confirms or refutes each decision from
# application_events. TRIAGE_LLM_ENABLED unlocks deciding + recording;
# TRIAGE_ACT_ENABLED additionally unlocks executing validated decisions
# (inert without the first). Both off => triage does nothing.
# TRIAGE_LLM_ENABLED=true
# TRIAGE_ACT_ENABLED=true

# Navigation LLM assist (M6/M7): when BOTH deterministic phases miss (no
# congruent anchor, Apply click resolved nothing, not a login wall), the
# model may promote ONE of the page's own harvested candidate links —
# validated verbatim against the candidate set, and the promoted URL still
# passes every downstream gate (congruence evidence, duplicate guard, URL
# store policy). On duplicate parks where the holder's company/role text
# differs, it records a same-job/different-job verdict as evidence on the
# report and review item; verdicts never unblock anything by themselves.
# NAV_LLM_ASSIST_ENABLED=true

# Hands-off cycle may LAUNCH the debug Chrome itself when the CDP endpoint
# is unreachable (same executable + persistent profile as
# `npm run chrome:debug:jobright`, so your logins survive). Fail closed.
CDP_AUTOLAUNCH_ENABLED=true


# STANDING employer-portal login: the ONE email + password you use for
# every job portal (ByteDance, Workday tenants, etc.). Set both and any
# login/create-account wall the apply flow reaches is answered
# automatically — no per-site setup. Leave the password unset and portal
# auth falls back to per-host vault entries only (fail-closed by absence).
# The email should be the mailbox your verification scanner reads, so
# emailed codes/links land where Dispatch can find them. Never logged,
# never written to artifacts; .env is gitignored and hook-enforced.
# PORTAL_LOGIN_EMAIL=you@example.com
# PORTAL_LOGIN_PASSWORD=your-standing-portal-password
# Which mailbox is scanned FIRST for verification codes. Derived from the
# PORTAL_LOGIN_EMAIL domain by default (@outlook/@hotmail/@live/@msn =>
# outlook); set this to force it when your Outlook inbox uses a custom
# domain. Both mailboxes stay in the chain either way.
# VERIFICATION_MAILBOX=outlook

# Navigation layer: clicking Apply on live JobRight mutates applied-state.
# Deterministic phase (read hrefs / click Apply) requires NAVIGATION_ENABLED;
# the browser-use agent phase additionally requires AGENT_FALLBACK_ENABLED.
# NAVIGATION_ENABLED=true

# Gmail verification-code retrieval during navigation and submit recovery.
# Primary transport is a READ-ONLY Playwright scan of mail.google.com in
# your Google-authenticated browser session (the same login JobRight uses)
# — no API token needed. The gmail.readonly REST API is used only if a
# token exists (npm run gmail:auth; Google usually blocks this scope for
# unverified apps — that's why the browser path is primary). Send is
# banned by check:forbidden either way.
# GMAIL_VERIFICATION_ENABLED=true

# Per-user Gmail for HOSTED users (plan v0.5 M19): Dispatch's own Google
# WEB OAuth client. The web app runs the consent (PKCE, readonly + compose
# — drafts only, never send; the scope set is pinned in
# src/gmail/readonlyGuards.ts); only the engine holds the secret and
# exchanges the code (tenant job gmail_exchange). Settings, not flags:
# drafting for a tenant stays behind its own gates. The repo-root desktop
# client_secret_*.json remains the operator's readonly-only client.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=https://<your-app>/gmail/callback

# Read-only Outlook web mailbox scan for submit verification codes
# (navigation + DOM reads in the operator's session; never compose/send).
# OUTLOOK_VERIFICATION_ENABLED=true

# ── Cloud plane (split-plane v0, docs/roadmap/cloud-deploy.md) ──
# Base URL baked into minted invite links (npm run invites:mint), e.g.
# https://your-domain.example — links come out as <base>/redeem?code=...
# CLOUD_BASE_URL=https://your-domain.example
# Engine<->Supabase sync (npm run cloud:sync): pushes aggregate status +
# submission screenshot receipts UP (the user's own application evidence);
# --pull brings onboarded users' wizard profiles DOWN into
# private/cloud/users/. The OPERATOR'S private/ data, vault entries and
# ATS credentials never go up. Fail-closed; refuses loudly unless all
# three SUPABASE_* settings are present. The service-role key stays on
# THIS machine only — never in frontend config, never in the repo.
SUPABASE_SYNC_ENABLED=false
# SUPABASE_URL=https://your-project-ref.supabase.co
# Key naming caveat: Supabase's NEW-style secret key (sb_secret_...) is a
# drop-in here — supabase-js v2 accepts it wherever the legacy service_role
# JWT went, with the same RLS-bypass powers (so treat it identically:
# engine machine only). The env var keeps its historical name.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key
# SUPABASE_SYNC_USER_ID=auth-users-uuid-of-the-cloud-account
# Personal access token (supabase.com → Account → Access Tokens), used ONLY
# by `npm run cloud:schema -- apply` to run supabase/migrations/ through
# the Management API (also needs SUPABASE_SYNC_ENABLED=true — DDL is a
# cloud mutation). `cloud:schema -- verify` is read-only and needs no token.
# SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
# Hosted/PaaS deployments only: platform env must beat any baked-in .env.
# Locally leave unset (repo .env stays the switchboard, overriding shell).
# DOTENV_OVERRIDE=false

# ── Multi-tenant engine (hosted users' own workspaces) ────────────────
# The engine may materialize a hosted user's workspace under TENANTS_ROOT
# (private/tenants/<uuid>/: their profile, documents, sealed sessions,
# their own SQLite) and run `auto:cycle` for them as a CHILD process whose
# flags are the ceiling ∩ the tenant's own (never wider than this file;
# ARTIFACT_AUTOPUSH / AGENT_FALLBACK / CDP_AUTOLAUNCH / OUTLOOK_* /
# TRIAGE_ACT / ATS_DISCOVERY forced off; PORTAL_LOGIN_PASSWORD and
# SUPABASE_ACCESS_TOKEN stripped). Requires SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY (refuses to boot without them); does NOT need
# SUPABASE_SYNC_USER_ID — tenants carry their own ids. Fail closed.
TENANT_ENGINE_ENABLED=false
# TENANTS_ROOT=private/tenants
# TENANT_MAX_CONCURRENT=1
# Child-process env only (set by the tenant runner, never here):
# CANDIDATE_KEY_PROVIDER=tenant selects the per-tenant key — HKDF of the
# DPAPI-wrapped master under TENANTS_ROOT with TENANT_USER_ID as the salt
# (src/tenants/keys.ts). Absent ⇒ today's operator key path, unchanged.
# HOSTED engine only (deploy/aws, Linux — no DPAPI there): the tenant
# master key itself, 32 random bytes as 64 hex chars (`openssl rand -hex
# 32`), injected from the host's secret store (AWS Secrets Manager → the
# container env). Never set it on the operator box, never commit it; the
# value is never logged. Losing it makes every sealed tenant session
# unreadable (users reconnect), so keep the secret's recovery window.
# TENANT_MASTER_KEY=
# The engine may attach (connectOverCDP) to a NON-loopback browser — the
# remote session a hosted user drives during a JobRight sign-in handoff.
# Off: only 127.0.0.1 CDP URLs are ever accepted. Requires the provider
# credentials below or refuses to boot. Keys are SECRET: never logged,
# never artifacted, never in any frontend. Fail closed.
REMOTE_BROWSER_ENABLED=false
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# ── Employer sandbox verification mail (optional, operator-run test rig) ──
# With these set, `npm run sandbox`'s /portal emails its verification code
# to YOUR inbox via Resend, so the mailbox-scan recovery can be rehearsed
# end to end. Without them the code prints to the sandbox terminal only.
# RESEND_API_KEY=
# SANDBOX_VERIFY_TO=            # defaults to PORTAL_LOGIN_EMAIL
# SANDBOX_VERIFY_FROM=          # defaults to Resend's onboarding sender
