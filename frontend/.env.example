# Public app build configuration (Vite; all values are baked in at build
# time). Copy to frontend/.env for local work. Same fail-closed posture
# as the backend's .env.example: nothing here is required for the app to
# BUILD — a missing value disables the capability with an honest notice,
# it never crashes the page.

# Supabase project for auth + the launcher-owned profiles/invites/quota
# schema. The anon key is the public client key (RLS protects data), but
# it still arrives via env, never a commit. Unset => sign-up renders
# disabled with the reason; the landing page still works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployed origin, no trailing slash (e.g. https://dispatch.example.com).
# Only used for absolute Open Graph / social-preview URLs in index.html;
# unset => the og:image tag is root-relative, which most scrapers skip.
VITE_PUBLIC_URL=

# How often the operator's engine syncs to the cloud (cloud:sync tick),
# in milliseconds. The dashboard's "engine running" indicator calls a
# heartbeat older than 2x this "offline". The OPERATOR defines the real
# cadence; unset => 5 minutes (frontend/src/public/engineStatus.ts).
VITE_ENGINE_SYNC_INTERVAL_MS=

# Per-user Gmail, drafts only (plan M19). The PUBLIC client id of
# Dispatch's Google WEB OAuth client; the browser runs a PKCE consent for
# readonly + compose and hands the code to the engine, which alone holds
# the secret (GMAIL_OAUTH_CLIENT_SECRET in the engine .env). Unset => the
# integrations step shows the Gmail card refused by name. The redirect
# defaults to <origin>/gmail/callback; set it only if Google was
# registered with a different one.
VITE_GMAIL_OAUTH_CLIENT_ID=
VITE_GMAIL_OAUTH_REDIRECT_URI=

# Origin of the remote-browser live view the JobRight connect step embeds
# (plan M17; Browserbase's https://www.browserbase.com by default). It is
# informational for the build — the iframe src comes from the handoff task
# row — but the deploy's Content-Security-Policy frame-src (vercel.json)
# must list the same origin or the live view renders blank. Unset => the
# default origin is assumed.
VITE_LIVE_VIEW_ORIGIN=

# INTERNAL operator console. Leave unset for any public deploy — the
# console then never mounts and is never downloaded. Operators building
# the local console set exactly: VITE_CONSOLE_ENABLED=true
VITE_CONSOLE_ENABLED=
